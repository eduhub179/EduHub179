# Токен бота-сборщика для чатов (отдельный бот, не TELEGRAM_BOT_TOKEN основного бота: getUpdates у одного токена читает только один процесс)
BOT_TOKEN=
# Бот-модератор (ДРУГОЙ бот, не BOT_TOKEN): находки из каналов и чатов ждут кнопки «Опубликовать»
MODERATOR_BOT_TOKEN=
# MODERATOR_CHAT_ID=   (по умолчанию модератором становится первый, кто напишет боту /start)
# Где запущена Ollama
OLLAMA_URL=http://localhost:11434
# Модель для текста
MODEL=qwen2.5:7b
# stub — фото без подписи считается ДЗ; board — распознавание доски моделью BOARD_MODEL
PHOTO_MODE=stub
# Порог уверенности Tesseract для текста с фото (0-100): ниже — фото считается рукописным и уходит в board.py
# OCR_MIN_CONF=70
# Расписание из бэкенда вместо timetable.json (когда появится)
# TIMETABLE_URL=
# Бэкенд EduHub: подтверждённые ДЗ и контрольные уходят туда (backend_api.py). Без API_URL ничего не отправляется.
# API_URL=http://localhost:8080
# Кто записывается автором домашки (user_id из таблицы users) и его роль: student / teacher / admin
# пользователь «агент» создаётся миграцией 0008_create_agent_user.sql
# AGENT_USER_ID=00000000-0000-0000-0000-0000000000c1
# AGENT_USER_ROLE=teacher
# тот же секрет, что AGENT_KEY в backend/.env: по нему бэкенд пускает агента в API (без него 401) и говорит, кто пишет боту в личку (dm.py)
# AGENT_KEY=
# основной бот EduHub179, где входят по школьной почте (бот подскажет, где войти)
# LOGIN_BOT=@имя_бота
# Один бот для всех: основной бот (бот Яши) читает Telegram и пересылает агенту сообщения из чатов и ДЗ из лички.
# Тогда BOT_TOKEN = токен основного бота, а агент слушает этот адрес (у бота AGENT_URL=http://127.0.0.1:8091/telegram/update)
# AGENT_LISTEN=127.0.0.1:8091
# Модель для классификации материалов (crawler/ingest). Должна быть скачана в Ollama.
# CLASSIFY_MODEL=qwen2.5:7b
