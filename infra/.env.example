# ==============================================================================
# POSTGRES
# ==============================================================================
# POSTGRES (PostgreSQL 16)
# ==============================================================================
# Credentials for the main application database.
# These values are passed to the official postgres Docker image.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=eduhub179

# Host port mapping (the container always listens on 5432 internally).
# Ensure this matches the port in your backend's DATABASE_URL.
POSTGRES_PORT=5432

# ==============================================================================
# REDIS (Redis 7)
# ==============================================================================
# Host port mapping for Redis.
REDIS_PORT=6379

# Uncomment and set a strong password if your Redis instance requires AUTH.
# For local Docker development without authentication, leave this commented out.
# REDIS_PASSWORD=your_secure_redis_password

# ==============================================================================
# MINIO (S3-compatible Object Storage)
# ==============================================================================
# Root credentials for the MinIO server (equivalent to AWS Access Key / Secret Key).
# IMPORTANT: MinIO requires the secret key to be at least 8 characters long.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Host port mappings.
# API port is used by the Rust backend for S3 API calls.
MINIO_API_PORT=9000
# Console port is used to access the MinIO Web UI (http://localhost:9001).
MINIO_CONSOLE_PORT=9001

# Optional: Name of the default bucket to be created on startup (if you use an init script).
MINIO_DEFAULT_BUCKET=eduhub179-files
