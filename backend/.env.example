# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
# Connection string for PostgreSQL. Required for sqlx and PgPool.
DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/eduhub179

# ==============================================================================
# AUTH & SECURITY
# ==============================================================================
# Secret key for signing JWT tokens (HS256). 
# IMPORTANT: Must be at least 32 bytes (characters) long.
JWT_SECRET=change_me_in_production_this_is_a_very_long_secret_key_1234567890

# JWT token lifetime in seconds. 
# MANDATORY: The application will fail to start if this is not set.
JWT_TTL_SECONDS=900

# ==============================================================================
# SERVER (Axum)
# ==============================================================================
# Host and port where the backend binary will listen.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# ==============================================================================
# DOMAIN SPECIFIC
# ==============================================================================
# School email domain used for login validation.
ORG_EMAIL_DOMAIN=@179.ru

# ==============================================================================
# CACHE (Redis) — Required for MVP (sessions, frequent query caching)
# ==============================================================================
# URL for Redis connection.
REDIS_URL=redis://localhost:6379
# Uncomment and set if your Redis instance requires a password (recommended for production).
# Leave commented out for local Docker development.
# REDIS_PASSWORD=your_secure_redis_password

# ==============================================================================
# FILE STORAGE (MinIO / Yandex Object Storage) — Required for MVP
# ==============================================================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=eduhub179-files
S3_REGION=us-east-1

# ==============================================================================
# NOTIFICATIONS (SMTP) — Required for MVP
# ==============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@179.ru
SMTP_PASSWORD=smtp_password
